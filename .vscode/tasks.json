{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Clean",
            "type": "shell",
            "command": "rm -rf build",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake Configure (Clang Debug)",
            "type": "shell",
            "command": "echo running_configuration && CC=clang CXX=clang++ cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug -DCMAKE_CXX_FLAGS_DEBUG='-g -O0'",
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "CMake Build (Debug)",
            "type": "shell",
            "command": "cmake --build build -j$(nproc)",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ build active file (manual)",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++20",
                "-g",
                "-O0",
                "-fcolor-diagnostics",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build",
            "detail": "Build active file using clang++ (Debug, no optimization)"
        }
    ]
}
